{
  // Serveur de synchronisation d'Oreille musicale (docs/DESIGN.md §10.8).
  // Mise en place : voir server/README.md.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oreille-musicale-sync",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "oreille-musicale-sync",
      // Identifiant donné par `npx wrangler d1 create oreille-musicale-sync`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
}
