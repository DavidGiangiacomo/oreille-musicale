{
  "name": "oreille-musicale",
  "version": "0.1.0",
  "private": true,
  "description": "Entraînement de l'oreille musicale : intervalles, accords, gammes et modes, avec progression et révisions espacées.",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavidGiangiacomo/oreille-musicale.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . && prettier --check .",
